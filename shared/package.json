{
    "name": "@super-netcentric-battleship/shared",
    "version": "0.0.1",
    "scripts": {
        "dev": "echo hello from the shared workspace",
        "tsc": "tsc -w",
        "build": "npx tsc"
    },
    "type": "module",
    "exports": {
        "./GameMessage.js": {
            "types": "./src/ts/GameMessage.ts",
            "default": "./src/js/GameMessage.js"
        },
        "./ServerMessage.js": {
            "types": "./src/ts/ServerMessage/index.ts",
            "default": "./src/js/ServerMessage/index.js"
        },
        "./ClientMessage.js": {
            "types": "./src/ts/ClientMessage/index.ts",
            "default": "./src/js/ClientMessage/index.js"
        },
        "./Game/*.js": {
            "types": "./src/ts/Game/*.ts",
            "default": "./src/js/Game/*.js"
        }
    }
}